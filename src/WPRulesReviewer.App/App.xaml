<Application x:Class="WPRulesReviewer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WPRulesReviewer.App"
             xmlns:conv="clr-namespace:WPRulesReviewer.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Tokens.xaml" />
                <ResourceDictionary Source="Assets/BrandMark.xaml" />
                <ResourceDictionary Source="Themes/Theme.Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:InverseBoolConverter x:Key="InvBool" />
            <conv:StringToVisibilityConverter x:Key="StrToVis" />
            <conv:CountToVisibilityConverter x:Key="CountToVis" />
            <conv:EqualsConverter x:Key="Equals" />
            <conv:SeverityToBrushConverter x:Key="SevToBrush" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:CategoryToBrushConverter x:Key="CatToBrush" />
            <conv:ActivityLevelToBrushConverter x:Key="LevelToBrush" />
            <conv:HexToBrushConverter x:Key="HexToBrush" />
            <conv:PositiveToVisibilityConverter x:Key="PositiveToVis" />
            <conv:DoubleToIntConverter x:Key="DoubleToInt" />
            <conv:IndexToChartBrushConverter x:Key="IndexToChartBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
