<UserControl x:Class="WPRulesReviewer.App.Views.ActivityLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:log="clr-namespace:WPRulesReviewer.Core.Logging;assembly=WPRulesReviewer.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="14"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="Activity log" Style="{StaticResource Text.Heading}" FontSize="14" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Entries.Count, StringFormat={}{0} entries}" Style="{StaticResource Text.Muted}" />
                    </Border>
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center"
                           Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis"
                           Text="{Binding Latest.Message}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <CheckBox Content="Auto-scroll" IsChecked="{Binding AutoScroll}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyAllCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding ClearCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Entries -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <ListBox x:Name="EntryList" ItemsSource="{Binding Entries}" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type log:ActivityLogEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                        Background="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center"
                                           FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                           Foreground="{DynamicResource Brush.TextMuted}"
                                           Text="{Binding Timestamp, StringFormat=HH:mm:ss}" />
                                <Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="4"
                                        Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource Brush.Accent}" CornerRadius="4"
                                        Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasBuild, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Build}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.AccentForeground}" />
                                </Border>
                                <TextBlock Grid.Column="4" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
    </Grid>
</UserControl>
