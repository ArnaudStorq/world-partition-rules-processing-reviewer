<UserControl x:Class="WPRulesReviewer.App.Views.FixAdvisorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels"
             xmlns:ai="clr-namespace:WPRulesReviewer.Core.Ai;assembly=WPRulesReviewer.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:WPRulesReviewer.App.Services"
             d:DataContext="{d:DesignInstance vm:FixAdvisorViewModel}"
             svc:Motion.FadeIn="True"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- One recommendation card -->
        <DataTemplate x:Key="RecommendationCard" DataType="{x:Type vm:FixRecommendationViewModel}">
            <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Card}"
                    Padding="{StaticResource Pad.Card}" Margin="0,0,0,10">
                <StackPanel>

                    <!-- Header: kind, title, risk and confidence -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding KindGlyph}" Style="{StaticResource Glyph}"
                                   FontSize="16" Margin="0,0,10,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource Brush.Accent}" />

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Border CornerRadius="{StaticResource Radius.Pill}" Padding="7,1"
                                        Background="{DynamicResource Brush.Control}" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding KindLabel}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </Border>
                                <Border CornerRadius="{StaticResource Radius.Pill}" Padding="7,1"
                                        Background="{DynamicResource Brush.Control}" Margin="0,0,6,0">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding Risk, StringFormat='Risk: {0}'}" />
                                </Border>
                                <Border CornerRadius="{StaticResource Radius.Pill}" Padding="7,1"
                                        Background="{DynamicResource Brush.Control}">
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding Confidence, StringFormat='Confidence: {0}/5'}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="2" CornerRadius="{StaticResource Radius.Pill}" Padding="9,2"
                                VerticalAlignment="Top" Background="{DynamicResource Brush.Selection}">
                            <TextBlock Text="{Binding AffectedCount, StringFormat='{}{0} rows'}" FontSize="11"
                                       FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                    </Grid>

                    <TextBlock Text="{Binding RootCause}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Selection pattern: what the tool will actually match -->
                    <Border Background="{DynamicResource Brush.Control}" CornerRadius="{StaticResource Radius.Control}"
                            Padding="9,6" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Matches" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding MatchDescription}" TextWrapping="Wrap" FontSize="12"
                                       FontFamily="{StaticResource Font.Mono}" />
                        </StackPanel>
                    </Border>

                    <!-- Concrete steps -->
                    <ItemsControl ItemsSource="{Binding Actions}" Margin="0,0,0,10"
                                  Visibility="{Binding HasActions, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type ai:FixAction}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="11"
                                               Margin="0,0,7,0" Foreground="{DynamicResource Brush.StatusExpected}" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Actions -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Primary}" Padding="12,6" Margin="0,0,8,0"
                                Content="Apply to all matches" Command="{Binding ApplyBatchCommand}"
                                Visibility="{Binding CanApply, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource Button.Subtle}" Padding="10,6" Margin="0,0,8,0"
                                Content="Show matches" Command="{Binding PreviewCommand}" />
                        <Button Style="{StaticResource Button.Subtle}" Padding="10,6"
                                Content="Delegate to Cursor" Command="{Binding DelegateCommand}"
                                ToolTip="Open a Cursor agent with the full context of these rows"
                                Visibility="{Binding IsDelegated, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <Border Background="{DynamicResource Brush.Selection}" CornerRadius="{StaticResource Radius.Control}"
                            Padding="9,6" Margin="0,10,0,0"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StrToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Style="{StaticResource Button.Primary}" Padding="14,7" Margin="0,0,8,0"
                    Command="{Binding AnalyzeCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock Text="Diagnose and propose fixes" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Subtle}" Padding="10,7" Margin="0,0,8,0"
                    Content="Undo last batch" Command="{Binding UndoLastBatchCommand}"
                    ToolTip="Revert the most recent set of applied fixes" />
            <Button Style="{StaticResource Button.Subtle}" Padding="10,7"
                    Content="Journal" Command="{Binding OpenJournalCommand}"
                    ToolTip="Show the fix journal file in Explorer" />
        </StackPanel>

        <!-- Scope chip -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.Selection}" CornerRadius="{StaticResource Radius.Control}"
                Padding="9,6" Margin="0,0,0,8"
                Visibility="{Binding HasScope, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Scoped to" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBlock Text="{Binding ScopeTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="340" />
                <Button Style="{StaticResource Button.Subtle}" Padding="6,2" Margin="8,0,0,0"
                        Command="{Binding ClearScopeCommand}" Content="Whole session" />
            </StackPanel>
        </Border>

        <!-- Progress / error -->
        <StackPanel Grid.Row="2">
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,0,0,8"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <Border Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.SevHigh}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="10,7" Margin="0,0,0,8"
                    Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Brush.SevHigh}" />
            </Border>
        </StackPanel>

        <!-- Results -->
        <Grid Grid.Row="3">
            <StackPanel VerticalAlignment="Center" Margin="18"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="32" HorizontalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}" />
                <TextBlock Text="No recommendation yet" Style="{StaticResource Text.Heading}"
                           HorizontalAlignment="Center" Margin="0,10,0,4" />
                <TextBlock TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Text.Muted}"
                           Text="Run the diagnosis to group the pass into problem families and get a fix proposal for each one." />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                <StackPanel>
                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Card}"
                            Padding="{StaticResource Pad.CardCompact}" Margin="0,0,0,10"
                            Visibility="{Binding HasNarrative, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Narrative}" TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Recommendations}"
                                  ItemTemplate="{StaticResource RecommendationCard}" />

                    <!-- Raw stream, useful when the agent answers something unparseable -->
                    <Expander Header="Agent output" Margin="0,4,0,0"
                              Visibility="{Binding LiveOutput, Converter={StaticResource StrToVis}}">
                        <TextBox Text="{Binding LiveOutput, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 MaxHeight="260" VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                 FontFamily="{StaticResource Font.Mono}" FontSize="11" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
