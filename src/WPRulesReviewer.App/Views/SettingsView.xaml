<UserControl x:Class="WPRulesReviewer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:SettingsViewModel}">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="LastChildFill" Value="False" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="120" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>
        <Style x:Key="WideBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="360" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource Text.Heading}" />
                    <TextBlock Text="Everything is configurable. Changes apply after Save." Style="{StaticResource Text.Muted}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Back to review" Style="{StaticResource Button.Subtle}"
                            Command="{Binding DataContext.ShowReviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Button Content="Reset defaults" Style="{StaticResource Button.Subtle}" Command="{Binding ResetToDefaultsCommand}" />
                    <Button Style="{StaticResource Button.Action}" Margin="8,0,0,0" Padding="16,7" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Foreground="White" Margin="0,0,8,0" />
                            <TextBlock Text="Save" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel>

                <!-- Appearance -->
                <Expander IsExpanded="True" Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE790;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Appearance" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Theme" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ComboBox Width="160" DockPanel.Dock="Right" ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding Model.Theme}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Accent color (hex)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Border Width="24" Height="24" CornerRadius="6" Margin="0,0,8,0"
                                        Background="{Binding Model.AccentColor}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                <TextBox Width="120" Text="{Binding Model.AccentColor}" />
                                <Button Content="Apply" Style="{StaticResource Button.Subtle}" Command="{Binding ApplyThemeCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="UI font scale" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.UiFontScale}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Items per page" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.ItemsPerPage}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Compact rows" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.CompactRows}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Show grid lines" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.ShowGridLines}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <!-- Window -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE737;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Window" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Start minimized" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.StartMinimized}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Confirm on exit" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.ConfirmOnExit}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <!-- Paths -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Paths" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="DefaultEditor.ini (oracle)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBox Style="{StaticResource WideBox}" Text="{Binding Model.DefaultEditorIniPath}" />
                                <Button Content="Browse" Style="{StaticResource Button.Subtle}" Command="{Binding BrowseIniCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Log download folder" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBox Style="{StaticResource WideBox}" Text="{Binding Model.LogDownloadFolder}" />
                                <Button Content="Browse" Style="{StaticResource Button.Subtle}" Command="{Binding BrowseLogFolderCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Export folder" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBox Style="{StaticResource WideBox}" Text="{Binding Model.ExportFolder}" />
                                <Button Content="Browse" Style="{StaticResource Button.Subtle}" Command="{Binding BrowseExportFolderCommand}" />
                            </StackPanel>
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="App data folder (suspicious reports)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <TextBox Style="{StaticResource WideBox}" Text="{Binding Model.AppDataFolder}" />
                                <Button Content="Browse" Style="{StaticResource Button.Subtle}" Command="{Binding BrowseAppDataFolderCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <!-- TeamCity -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="TeamCity" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource Brush.LevelInfo}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding TeamCityTokenHelpTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding TeamCityTokenHelp}" Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18" />
                            </StackPanel>
                        </Border>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Base URL" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource WideBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCityBaseUrl}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Build type id" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource WideBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCityBuildTypeId}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Access token (Bearer)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <PasswordBox Width="360" DockPanel.Dock="Right" x:Name="TokenBox" PasswordChanged="TokenBox_OnPasswordChanged" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Username (fallback)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource WideBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCityUsername}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Password (fallback)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <PasswordBox Width="360" DockPanel.Dock="Right" x:Name="PwdBox" PasswordChanged="PwdBox_OnPasswordChanged" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Max builds" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCityMaxBuilds}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Lookback hours (0 = all)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCityLookbackHours}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Recent days shown (before More...)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCityRecentDays}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Auto-refresh builds on startup" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.AutoRefreshOnStartup}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Preselect latest day on startup" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.PreselectLatestDayOnStartup}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Only successful builds" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.TeamCityOnlySuccessful}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Verify SSL" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.TeamCityVerifySsl}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Artifact log path" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource WideBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCityArtifactLogPath}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Session tag regex" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource WideBox}" DockPanel.Dock="Right" Text="{Binding Model.TeamCitySessionTagRegex}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="{Binding TeamCityTestResult}" Style="{StaticResource Text.Muted}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                            <Button Content="Test connection" Style="{StaticResource Button.Subtle}" DockPanel.Dock="Right" Command="{Binding TestTeamCityCommand}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <!-- Parsing -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Parsing" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Deduplicate warnings" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.DeduplicateWarnings}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Resolve context paths" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.ResolveContextPaths}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Keep progress lines" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.KeepProgressLines}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Max records / session (0 = all)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.MaxRecordsPerSession}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <!-- Triage -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Triage" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Treat nav skip as noise" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.TreatNavSkipAsNoise}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Empty missing DataLayer = noise" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.TreatEmptyMissingDataLayerAsNoise}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Show Expected in report" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.ShowExpectedInReport}" />
                        </DockPanel>
                        <StackPanel Margin="0,6">
                            <TextBlock Text="Noise actor patterns (one per line)" Style="{StaticResource RowLabel}" />
                            <TextBox Height="80" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Margin="0,4,0,0" Text="{Binding NoiseActorPatternsText}" />
                        </StackPanel>
                        <StackPanel Margin="0,6">
                            <TextBlock Text="Unclassified tokens to flag (one per line)" Style="{StaticResource RowLabel}" />
                            <TextBox Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Margin="0,4,0,0" Text="{Binding FlagUnclassifiedTokensText}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- AI -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="AI (Cursor SDK local)" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{DynamicResource Brush.LevelInfo}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding CursorAgentHelpTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding CursorAgentHelp}" Style="{StaticResource Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="18" />
                            </StackPanel>
                        </Border>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Enable AI" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.EnableAi}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="cursor-agent path" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource WideBox}" DockPanel.Dock="Right" Text="{Binding Model.CursorAgentPath}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Model" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Width="200" DockPanel.Dock="Right" Text="{Binding Model.AiModel}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Max anomalies sent" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.AiMaxAnomalies}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Timeout (seconds)" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.AiTimeoutSeconds}" />
                        </DockPanel>
                        <StackPanel Margin="0,6">
                            <TextBlock Text="Extra AI instructions" Style="{StaticResource RowLabel}" />
                            <TextBox Height="70" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Margin="0,4,0,0" Text="{Binding Model.AiExtraInstructions}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Performance -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC4A;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Performance" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Max parallel sessions" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.MaxParallelSessions}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="UI virtualization batch" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.UiVirtualizationBatch}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <!-- Activity log -->
                <Expander Margin="0,0,0,10">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Activity log" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Log to file" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.LogToFile}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Verbose logging" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.VerboseLogging}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Max activity entries" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.MaxActivityEntries}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Show original log line(s) on row click" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.LogRowContextOnSelect}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Context lines around match" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Style="{StaticResource NumBox}" DockPanel.Dock="Right" Text="{Binding Model.RowContextLines}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

                <!-- Export -->
                <Expander Margin="0,0,0,20">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEDE1;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,9,0" />
                            <TextBlock Text="Export" Style="{StaticResource SectionHeader}" />
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="CSV delimiter" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <TextBox Width="80" DockPanel.Dock="Right" Text="{Binding Model.CsvDelimiter}" />
                        </DockPanel>
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Text="Auto-export anomalies on analyze" Style="{StaticResource RowLabel}" DockPanel.Dock="Left" />
                            <ToggleButton Style="{StaticResource Switch}" DockPanel.Dock="Right" IsChecked="{Binding Model.AutoExportAnomaliesOnAnalyze}" />
                        </DockPanel>
                    </StackPanel>
                </Expander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
