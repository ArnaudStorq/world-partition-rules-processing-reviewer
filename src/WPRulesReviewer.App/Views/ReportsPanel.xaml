<UserControl x:Class="WPRulesReviewer.App.Views.ReportsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WPRulesReviewer.App.Controls"
             xmlns:core="clr-namespace:WPRulesReviewer.Core.Models;assembly=WPRulesReviewer.Core">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / toolbar -->
        <Grid Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding HeaderGlyph}" Style="{StaticResource Glyph}" FontSize="14"
                           Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" FontSize="14" VerticalAlignment="Center" />
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="6" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Count, StringFormat={}{0} reports}" Style="{StaticResource Text.Muted}" />
                </Border>
                <Border Margin="10,0,0,0" VerticalAlignment="Center" Width="660"
                        Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="9,0,0,0" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Padding="6,4"
                                 ToolTip="Search reports (actor, comment, session, assignment...)" />
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="6,0" Margin="0,0,4,0"
                                ToolTip="Clear search"
                                Visibility="{Binding SearchText, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                        </Button>
                    </Grid>
                </Border>
                <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyAllCommand}" Margin="10,0,0,0"
                        ToolTip="Copy every report to the clipboard as text (actor path, assignment and comment)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Copy all reports to clipboard" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Subtle}" Command="{Binding RefreshCommand}"
                        ToolTip="Reload the reports from disk">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <!-- Empty state -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding HeaderGlyph}" Style="{StaticResource Glyph}" FontSize="40"
                               Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="No reports yet" Style="{StaticResource Text.Muted}" Margin="0,10,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Grid Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" MinWidth="280" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="2*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- Master list -->
                    <ListBox Grid.Column="0" ItemsSource="{Binding Reports}" SelectedItem="{Binding Selected}"
                             Background="Transparent" BorderThickness="0" Padding="6,4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <EventSetter Event="MouseDoubleClick" Handler="ReportItem_OnMouseDoubleClick" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:SuspiciousReport}">
                                <Border Background="{DynamicResource Brush.Control}" CornerRadius="8"
                                        BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1"
                                        Padding="10,8" Margin="2,3">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource Brush.Accent}" CornerRadius="4"
                                                    Padding="6,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding AssignmentType}" FontSize="10.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.AccentForeground}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding ActorSummary}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Button Grid.Column="2" Style="{StaticResource Button.Subtle}" Padding="4,1"
                                                    VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Command="{Binding DataContext.DeleteReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete this report">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12"
                                                           Foreground="{DynamicResource Brush.StatusError}" />
                                            </Button>
                                        </Grid>
                                        <controls:StarRating Rating="{Binding Confidence}" GlyphSize="13"
                                                             IsReadOnly="True" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding Comment}" Style="{StaticResource Text.Muted}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,3,0,0">
                                            <Run Text="{Binding SessionName, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding ReportedAt, Mode=OneWay, StringFormat=g}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" />

                    <!-- Detail -->
                    <Border Grid.Column="2" Margin="4,6,8,8">
                        <Grid>
                            <TextBlock Style="{StaticResource Text.Muted}" Margin="12" TextWrapping="Wrap"
                                       Text="Select a report on the left to see its full context."
                                       Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                                <StackPanel Margin="6,4" DataContext="{Binding Selected}">
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Confidence" Style="{StaticResource Text.Muted}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <controls:StarRating Rating="{Binding Confidence, Mode=OneWay}"
                                                                 GlyphSize="20" VerticalAlignment="Center"
                                                                 IsReadOnly="True" />
                                            <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" VerticalAlignment="Center"
                                                       Margin="10,0,0,0">
                                                <Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text="/5" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Comment" Style="{StaticResource Text.Muted}" FontSize="11" />
                                            <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" FontSize="13.5"
                                                       Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4">
                                        <Run Text="Actors" />
                                        <Run Text=" (" /><Run Text="{Binding ActorCount, Mode=OneWay}" /><Run Text=")" />
                                    </TextBlock>
                                    <ItemsControl ItemsSource="{Binding Actors}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8"
                                                        Padding="12,10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ActorPath}" TextWrapping="Wrap"
                                                                   FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Operation" Style="{StaticResource Text.Muted}" FontSize="11" />
                                                                <TextBlock Text="{Binding AssignmentType}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Category" Style="{StaticResource Text.Muted}" FontSize="11" />
                                                                <TextBlock Text="{Binding Category}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <Grid Margin="0,8,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="Value" Style="{StaticResource Text.Muted}" FontSize="11" />
                                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Status" Style="{StaticResource Text.Muted}" FontSize="11" />
                                                                <TextBlock Text="{Binding Status}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding RawLine}" TextWrapping="Wrap" Margin="0,8,0,0"
                                                                   FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="TeamCity build" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" />
                                    <TextBlock Margin="0,2,0,10" TextWrapping="Wrap">
                                        <Run Text="{Binding SessionName, Mode=OneWay}" />
                                        <Run Text="  ·  build " />
                                        <Run Text="{Binding BuildNumber, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Bottom action bar -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Subtle}" Command="{Binding EditCommand}"
                        ToolTip="Edit the selected report's comment">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Subtle}" Command="{Binding DeleteCommand}"
                        ToolTip="Delete the selected report">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0"
                                   Foreground="{DynamicResource Brush.StatusError}" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Subtle}" Command="{Binding OpenFolderCommand}"
                        ToolTip="Open the folder that holds the JSON journals in Windows Explorer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="Open JSON files in Explorer" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
