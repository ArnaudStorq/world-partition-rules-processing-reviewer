<UserControl x:Class="WPRulesReviewer.App.Views.OverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:svc="clr-namespace:WPRulesReviewer.App.Services"
             d:DataContext="{d:DesignInstance vm:OverviewViewModel}"
             svc:Motion.FadeIn="True"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- Legend row: color chip, label, count and share. Clicking scopes the grid. -->
        <DataTemplate x:Key="LegendRow" DataType="{x:Type vm:OverviewSliceViewModel}">
            <Button HorizontalContentAlignment="Stretch" Style="{StaticResource Button.Subtle}" Padding="6,4"
                    Command="{Binding DataContext.SelectSliceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="Show only these records in the grid">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,9,0" VerticalAlignment="Center"
                            Background="{Binding Brush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Count}" FontWeight="SemiBold" Margin="10,0,0,0"
                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding ShareLabel}" Style="{StaticResource Text.Muted}"
                               Width="42" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Button>
        </DataTemplate>

        <Style x:Key="Kpi" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}" />
            <Setter Property="Padding" Value="{StaticResource Pad.CardCompact}" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state -->
        <StackPanel VerticalAlignment="Center" Margin="24"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
            <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="34" HorizontalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <TextBlock Text="Nothing to chart yet" Style="{StaticResource Text.Heading}"
                       HorizontalAlignment="Center" Margin="0,10,0,4" />
            <TextBlock Text="Analyze a log to see the proportions of this pass." Style="{StaticResource Text.Muted}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,6,0"
                      Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <StackPanel>

                <!-- KPI strip -->
                <UniformGrid Rows="1" Margin="0,0,0,12">
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Text="Records" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Text="To triage" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding LitigiousCount}" FontSize="20" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{DynamicResource Brush.StatusAnomaly}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel>
                            <TextBlock Text="Problem families" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding SignatureCount}" FontSize="20" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Kpi}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Reviewed" Style="{StaticResource Text.Muted}" />
                            <TextBlock Text="{Binding ReadRatioLabel}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.StatusExpected}" />
                            <ProgressBar Height="3" Margin="0,5,0,0" Minimum="0" Maximum="1"
                                         Value="{Binding ReadRatio, Mode=OneWay}"
                                         Background="{DynamicResource Brush.ChartTrack}"
                                         Foreground="{DynamicResource Brush.StatusExpected}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Donut: problem families -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Card}"
                        Padding="{StaticResource Pad.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Problems by family" Style="{StaticResource Text.Heading}" Margin="0,0,0,2" />
                        <TextBlock Text="Share of the anomalies, errors and items needing review."
                                   Style="{StaticResource Text.Muted}" Margin="0,0,0,10" />
                        <Grid Height="230">
                            <lvc:PieChart x:Name="SignatureChart" Series="{Binding SignatureSeries}"
                                          LegendPosition="Hidden" TooltipPosition="Top"
                                          DataPointerDown="SignatureChart_OnDataPointerDown" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding LitigiousCount}" FontSize="26" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="to triage" Style="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Legend}" ItemTemplate="{StaticResource LegendRow}"
                                      Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <!-- Bars: what is left to review, per family -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Card}"
                        Padding="{StaticResource Pad.Card}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Review progress by family" Style="{StaticResource Text.Heading}" Margin="0,0,0,2" />
                        <TextBlock Text="Ten largest families, split between reviewed and remaining."
                                   Style="{StaticResource Text.Muted}" Margin="0,0,0,10" />
                        <lvc:CartesianChart Height="300"
                                            Series="{Binding TopProblemSeries}"
                                            XAxes="{Binding TopProblemXAxes}"
                                            YAxes="{Binding TopProblemYAxes}"
                                            LegendPosition="Bottom"
                                            TooltipPosition="Top" />
                    </StackPanel>
                </Border>

                <!-- Donut: triage status -->
                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="{StaticResource Radius.Card}"
                        Padding="{StaticResource Pad.Card}">
                    <StackPanel>
                        <TextBlock Text="Triage status" Style="{StaticResource Text.Heading}" Margin="0,0,0,2" />
                        <TextBlock Text="How the deterministic oracle classified the whole pass."
                                   Style="{StaticResource Text.Muted}" Margin="0,0,0,10" />
                        <Grid Height="190">
                            <lvc:PieChart x:Name="StatusChart" Series="{Binding StatusSeries}"
                                          LegendPosition="Hidden" TooltipPosition="Top"
                                          DataPointerDown="StatusChart_OnDataPointerDown" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text="records" Style="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding StatusLegend}" ItemTemplate="{StaticResource LegendRow}"
                                      Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
