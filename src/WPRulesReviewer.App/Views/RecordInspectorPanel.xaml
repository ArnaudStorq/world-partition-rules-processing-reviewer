<UserControl x:Class="WPRulesReviewer.App.Views.RecordInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Margin="14,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="14"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="Selection details" Style="{StaticResource Text.Heading}" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyOutlinerPathCommand}"
                            IsEnabled="{Binding HasActor}"
                            ToolTip="Copy the actor's Outliner path to the clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Copy path" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyActorNameCommand}"
                            IsEnabled="{Binding HasActor}"
                            ToolTip="Copy the actor name to the clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Copy name" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyAllCommand}"
                            ToolTip="Copy the selection details to the clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Copy" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding ClearCommand}"
                            ToolTip="Clear the selection details">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Text.Muted}" Margin="16" TextWrapping="Wrap"
                               Text="Select a row in the table to inspect the record and its original Sundance.log line(s)."
                               Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding HasContent, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Lines}" Margin="4,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:InspectorLine}">
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Padding="8,3"
                                               Foreground="{DynamicResource Brush.TextPrimary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="12.5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="FontSize" Value="13.5" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                                                        <Setter Property="FontSize" Value="12" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMatch}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
    </Grid>
</UserControl>
