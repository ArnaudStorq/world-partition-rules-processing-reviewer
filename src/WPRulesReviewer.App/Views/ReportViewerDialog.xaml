<Window x:Class="WPRulesReviewer.App.Views.ReportViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WPRulesReviewer.App.Controls"
        Title="Report" Height="620" Width="720" MinHeight="420" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,2" Padding="18,14"
                Background="{DynamicResource Brush.HeaderBg}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="KindGlyph" Style="{StaticResource Glyph}" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="KindTitle" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Read-only view" Style="{StaticResource Text.Muted}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Confidence" Style="{StaticResource Text.Muted}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <controls:StarRating Rating="{Binding Confidence, Mode=OneWay}" GlyphSize="18"
                                         IsReadOnly="True" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text="/5" />
                    </TextBlock>
                </StackPanel>

                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Comment" Style="{StaticResource Text.Muted}" FontSize="11" />
                        <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" FontSize="13.5" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,0,0,4">
                    <Run Text="Actors" />
                    <Run Text=" (" /><Run Text="{Binding ActorCount, Mode=OneWay}" /><Run Text=")" />
                </TextBlock>
                <ItemsControl ItemsSource="{Binding Actors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding ActorPath}" TextWrapping="Wrap"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Operation" Style="{StaticResource Text.Muted}" FontSize="11" />
                                            <TextBlock Text="{Binding AssignmentType}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Value" Style="{StaticResource Text.Muted}" FontSize="11" />
                                            <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="TeamCity build" Style="{StaticResource Text.Muted}" FontSize="11" Margin="0,4,0,0" />
                <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                    <Run Text="{Binding SessionName, Mode=OneWay}" />
                    <Run Text="  ·  build " />
                    <Run Text="{Binding BuildNumber, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12">
            <Button HorizontalAlignment="Right" Style="{StaticResource Button.Subtle}" Content="Close"
                    Padding="18,7" IsCancel="True" />
        </Border>
    </Grid>
</Window>
