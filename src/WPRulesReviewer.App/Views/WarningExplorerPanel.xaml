<UserControl x:Class="WPRulesReviewer.App.Views.WarningExplorerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels"
             xmlns:svc="clr-namespace:WPRulesReviewer.App.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance vm:WarningExplorerViewModel}"
             svc:Motion.FadeIn="True"
             mc:Ignorable="d">

    <UserControl.Resources>

        <!-- Tree row: severity dot, glyph, title, count pill and a read-progress underline. -->
        <HierarchicalDataTemplate DataType="{x:Type vm:WarningNodeViewModel}" ItemsSource="{Binding Children}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="4" Height="16" CornerRadius="2" Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{Binding MaxSeverity, Converter={StaticResource SevToBrush}}" />

                <TextBlock Grid.Column="1" Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="12"
                           Margin="0,0,7,0" Foreground="{DynamicResource Brush.TextMuted}" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Title}" />
                    <!-- Read progress: only drawn once something was reviewed, to keep the tree calm. -->
                    <ProgressBar Height="2" Margin="0,3,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding ReadRatio, Mode=OneWay}"
                                 Background="{DynamicResource Brush.ChartTrack}"
                                 Foreground="{DynamicResource Brush.StatusExpected}"
                                 Visibility="{Binding ReadRatio, Converter={StaticResource PositiveToVis}}" />
                </StackPanel>

                <Border Grid.Column="3" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" MinWidth="26"
                        VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceAlt}"
                        ToolTip="{Binding CountTooltip}">
                    <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" TextAlignment="Center"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
            </Grid>
        </HierarchicalDataTemplate>

        <!-- Custom item template: the expander is driven by HasChildren so children stay unbuilt
             until the user actually expands the node. -->
        <Style x:Key="ExplorerItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="row" CornerRadius="6" Padding="6,5" Margin="0,1"
                                    Background="Transparent" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- Fixed, so a childless row keeps the same left offset as its
                                             siblings instead of sliding back under its parent. -->
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Indentation grows with depth through the nested ItemsPresenter margin. -->
                                    <ToggleButton x:Name="expander" Grid.Column="0" Width="16" Height="16"
                                                  Margin="0,0,4,0" Cursor="Hand" Focusable="False"
                                                  HorizontalAlignment="Left"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Visibility="{Binding HasChildren, Converter={StaticResource BoolToVis}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path x:Name="arrow" Width="7" Height="7" Stretch="Uniform"
                                                          Data="M 0,0 L 5,5 L 0,10" StrokeThickness="1.6"
                                                          Stroke="{DynamicResource Brush.TextMuted}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="0" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="arrow" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="arrow" Property="Stroke"
                                                                Value="{DynamicResource Brush.Accent}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>

                                    <ContentPresenter Grid.Column="2" ContentSource="Header"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="items" Margin="14,0,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="items" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="14,12,10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="15"
                               Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                    <TextBlock Text="Warning Explorer" Style="{StaticResource Text.Heading}" FontSize="14"
                               VerticalAlignment="Center" />
                    <Border CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.SurfaceAlt}">
                        <TextBlock Text="{Binding TotalCount}" FontSize="11" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Icon}" FontSize="13" Padding="6"
                            Command="{Binding ExpandTopLevelCommand}" ToolTip="Expand two levels"
                            Content="&#xE8A9;" />
                    <Button Style="{StaticResource Button.Icon}" FontSize="13" Padding="6"
                            Command="{Binding CollapseAllCommand}" ToolTip="Collapse all"
                            Content="&#xE8A8;" />
                </StackPanel>
            </Grid>

            <!-- Group-by preset -->
            <DockPanel Grid.Row="1" Margin="12,0,12,8">
                <TextBlock Text="Group by" Style="{StaticResource Text.Muted}" VerticalAlignment="Center"
                           DockPanel.Dock="Left" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name" />
            </DockPanel>

            <!-- Search -->
            <Border Grid.Row="2" Margin="12,0,12,8" Background="{DynamicResource Brush.Control}"
                    BorderBrush="{DynamicResource Brush.ControlBorder}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="13"
                               Foreground="{DynamicResource Brush.TextMuted}" Margin="9,0,0,0" />
                    <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="6,6"
                             VerticalAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Padding="6,0" Margin="0,0,4,0"
                            Visibility="{Binding SearchText, Converter={StaticResource StrToVis}}">
                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Tree -->
            <Grid Grid.Row="3">
                <StackPanel VerticalAlignment="Center" Margin="24"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="32"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="Nothing to browse" Style="{StaticResource Text.Heading}"
                               HorizontalAlignment="Center" Margin="0,10,0,4" />
                    <TextBlock Text="No record matches the current search." Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <TreeView x:Name="Tree" ItemsSource="{Binding Roots}"
                          ItemContainerStyle="{StaticResource ExplorerItem}"
                          Background="Transparent" BorderThickness="0" Padding="8,0,8,10"
                          SelectedItemChanged="Tree_OnSelectedItemChanged"
                          PreviewMouseRightButtonDown="Tree_OnPreviewMouseRightButtonDown"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TreeView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </TreeView.ItemsPanel>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Mark subtree as read"
                                      Command="{Binding MarkSubtreeReadCommand}"
                                      CommandParameter="{Binding SelectedNode}" />
                            <MenuItem Header="Approve subtree..."
                                      Command="{Binding ApproveSubtreeCommand}"
                                      CommandParameter="{Binding SelectedNode}" />
                            <MenuItem Header="Flag subtree..."
                                      Command="{Binding FlagSubtreeCommand}"
                                      CommandParameter="{Binding SelectedNode}" />
                            <Separator />
                            <MenuItem Header="Ask the Fix Advisor about this node"
                                      Command="{Binding AskAiAboutNodeCommand}"
                                      CommandParameter="{Binding SelectedNode}" />
                            <MenuItem Header="Open in Cursor"
                                      Command="{Binding OpenNodeInCursorCommand}"
                                      CommandParameter="{Binding SelectedNode}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                </TreeView>
            </Grid>
        </Grid>
    </Border>
</UserControl>
