<Window x:Class="WPRulesReviewer.App.Views.AiThoughtDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels"
        xmlns:controls="clr-namespace:WPRulesReviewer.App.Controls"
        Title="AI Check" Height="820" Width="1040" MinHeight="480" MinWidth="640"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="0,0,0,2" Padding="18,14"
                Background="{DynamicResource Brush.HeaderBg}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEC61;" Style="{StaticResource Glyph}" FontSize="20" VerticalAlignment="Center"
                           Margin="0,0,12,0" Foreground="{DynamicResource Brush.Accent}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="What the AI thought about this actor" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="The AI related this actor to your reports but left the final decision to you."
                               Style="{StaticResource Text.Muted}" FontSize="12" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>
                <TextBlock Text="Actor" Style="{StaticResource Text.Muted}" FontSize="11" />
                <TextBlock Text="{Binding ActorPath}" TextWrapping="Wrap"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,2,0,10" />

                <TextBlock Text="Assignment" Style="{StaticResource Text.Muted}" FontSize="11" />
                <TextBlock Text="{Binding Assignment}" Margin="0,2,0,10" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                            Visibility="{Binding HasConfidence, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="AI confidence" Style="{StaticResource Text.Muted}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <controls:StarRating Rating="{Binding Confidence, Mode=OneWay}" GlyphSize="18"
                                         IsReadOnly="True" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Run Text="{Binding Confidence, Mode=OneWay}" /><Run Text="/5" />
                    </TextBlock>
                </StackPanel>

                <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="AI reasoning" Style="{StaticResource Text.Muted}" FontSize="11" />
                        <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" FontSize="13.5" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Reports the AI relied on" Style="{StaticResource Text.Muted}" FontSize="11"
                           Margin="0,0,0,4"
                           Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Reports}"
                              Visibility="{Binding HasReports, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AutoResolveReportRefViewModel}">
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding OpenCommand}" Cursor="Hand"
                                                BorderThickness="0" Background="Transparent" Padding="0"
                                                ToolTip="Open this report (read-only)">
                                            <TextBlock Text="{Binding Badge}" FontWeight="SemiBold" FontSize="12.5"
                                                       Foreground="{DynamicResource Brush.Accent}"
                                                       TextDecorations="Underline" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Comment}" TextWrapping="Wrap" FontSize="12.5"
                                               Style="{StaticResource Text.Muted}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12">
            <Button HorizontalAlignment="Right" Style="{StaticResource Button.Subtle}" Content="Close"
                    Padding="18,7" IsCancel="True" />
        </Border>
    </Grid>
</Window>
