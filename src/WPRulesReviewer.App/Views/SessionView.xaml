<UserControl x:Class="WPRulesReviewer.App.Views.SessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels"
             xmlns:core="clr-namespace:WPRulesReviewer.Core.Models;assembly=WPRulesReviewer.Core"
             xmlns:mdxam="clr-namespace:MdXaml;assembly=MdXaml"
             d:DataContext="{d:DesignInstance vm:SessionViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <UserControl.Resources>
        <Style x:Key="FilterCheck" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <!-- Category tab (Fluent-style pivot) -->
        <Style x:Key="FilterTab" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabCount" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        </Style>

        <!-- Outlined dropdown button used by the "Filter by ..." value pickers.
             Tag carries the per-type accent brush so it matches its scope box. -->
        <Style x:Key="FilterDropdownButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource Brush.Control}"
                                BorderBrush="{TemplateBinding Tag}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable "Filter by ..." dropdown. DataContext = AssignmentValueFilter.
             The owning ContentControl.Tag carries the per-type accent brush. -->
        <DataTemplate x:Key="FilterDropdownTemplate">
            <Grid>
                <ToggleButton x:Name="FilterBtn" Style="{StaticResource FilterDropdownButton}"
                              Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
                        <TextBlock Text="{Binding ButtonLabel}" VerticalAlignment="Center" />
                        <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                 Fill="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                 Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="10" Margin="7,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </ToggleButton>
                <Popup IsOpen="{Binding IsChecked, ElementName=FilterBtn}" StaysOpen="False"
                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="8" MinWidth="240" Margin="0,4,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource Button.Subtle}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,5,0" />
                                        <TextBlock Text="All" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Subtle}" Command="{Binding SelectNoneCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,5,0" />
                                        <TextBlock Text="None" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Display}" />
                                                </CheckBox>
                                                <Border Grid.Column="1" Background="{DynamicResource Brush.Control}"
                                                        CornerRadius="9" Padding="7,1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </DataTemplate>

        <!-- Per-assignment-type accent colors (shared by the scope box and its "Filter by" dropdown) -->
        <SolidColorBrush x:Key="Brush.Type.All" Color="#94A3B8" />
        <SolidColorBrush x:Key="Brush.Type.Hlod" Color="#8B5CF6" />
        <SolidColorBrush x:Key="Brush.Type.Include" Color="#14B8A6" />
        <SolidColorBrush x:Key="Brush.Type.DataLayer" Color="#3B82F6" />
        <SolidColorBrush x:Key="Brush.Type.Grid" Color="#F59E0B" />

        <!-- Scope box (assignment-type filter, mirrors the website count boxes).
             Tag carries the per-type accent brush used for the border and count badge. -->
        <Style x:Key="ScopeBox" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1" Padding="12,8"
                                Background="{DynamicResource Brush.Control}"
                                BorderBrush="{TemplateBinding Tag}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.Selection}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScopeCount" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        </Style>

        <!-- Per-row Read toggle used in the grid "Read" column. DataContext = RuleRecord. -->
        <Style x:Key="ReadToggleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1" Padding="8,3"
                                Background="{DynamicResource Brush.Control}"
                                BorderBrush="{DynamicResource Brush.ControlBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ico" Text="&#xE739;" Style="{StaticResource Glyph}" FontSize="13"
                                           Margin="0,0,6,0" Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock x:Name="txt" Text="Mark read" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                <Setter TargetName="ico" Property="Text" Value="&#xE73E;" />
                                <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Brush.StatusExpected}" />
                                <Setter TargetName="txt" Property="Text" Value="Read" />
                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource Brush.StatusExpected}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.StatusExpected}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-row "approve as valid" button. DataContext = RuleRecord. -->
        <Style x:Key="ApproveToggleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1" Padding="8,3"
                                Background="{DynamicResource Brush.Control}"
                                BorderBrush="{DynamicResource Brush.ControlBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ico" Text="&#xE8E1;" Style="{StaticResource Glyph}" FontSize="13"
                                           Margin="0,0,6,0" Foreground="{DynamicResource Brush.StatusExpected}" />
                                <TextBlock x:Name="txt" Text="Approve" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsApproved}" Value="True">
                                <Setter TargetName="ico" Property="Text" Value="&#xE8FB;" />
                                <Setter TargetName="txt" Property="Text" Value="Approved" />
                                <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource Brush.StatusExpected}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Brush.StatusExpected}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-row "flag as suspicious" button. DataContext = RuleRecord. -->
        <Style x:Key="FlagToggleButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" BorderThickness="1" Padding="8,3"
                                Background="{DynamicResource Brush.Control}"
                                BorderBrush="{DynamicResource Brush.ControlBorder}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ico" Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="13"
                                           Margin="0,0,6,0" Foreground="#F5A623" />
                                <TextBlock x:Name="txt" Text="Flag" FontSize="11.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Brush.ControlHover}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsReported}" Value="True">
                                <Setter TargetName="ico" Property="Text" Value="&#xEB90;" />
                                <Setter TargetName="txt" Property="Text" Value="Flagged" />
                                <Setter TargetName="txt" Property="Foreground" Value="#F5A623" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#F5A623" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact record row used by the side "insights" lists -->
        <DataTemplate x:Key="InsightRow" DataType="{x:Type core:RuleRecord}">
            <StackPanel Margin="2,4">
                <StackPanel Orientation="Horizontal">
                    <Border CornerRadius="4" Padding="5,0" Margin="0,0,7,0" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.SurfaceAlt}">
                        <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </Border>
                    <TextBlock Text="{Binding Value}" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Severity}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Severity, Converter={StaticResource SevToBrush}}" />
                </StackPanel>
                <TextBlock Text="{Binding DisplayActor}" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding StatusReason}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,1,0,0"
                           Visibility="{Binding StatusReason, Converter={StaticResource StrToVis}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Grouped problem: one row per distinct issue, expandable to reveal every affected actor/asset -->
        <DataTemplate x:Key="InsightGroupRow" DataType="{x:Type vm:InsightGroup}">
            <Border Margin="2,3" CornerRadius="6" Background="{DynamicResource Brush.SurfaceAlt}">
                <Expander Padding="8,6" IsExpanded="False">
                    <Expander.Header>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Severity}" FontSize="11" Margin="0,1,0,0"
                                           Foreground="{Binding Severity, Converter={StaticResource SevToBrush}}" />
                            </StackPanel>
                            <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="9" MinWidth="26" Padding="7,1"
                                    Background="{DynamicResource Brush.Accent}">
                                <TextBlock Text="{Binding Count}" Foreground="White" FontWeight="SemiBold"
                                           FontSize="11" TextAlignment="Center" />
                            </Border>
                            <Button Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Padding="7,3"
                                    Style="{StaticResource Button.Action}"
                                    Command="{Binding DataContext.OpenInCursorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Open a new Cursor agent thread pre-loaded with the full context of this issue and ask it to investigate and draft a plan to fix it.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,5,0"
                                               Foreground="White" />
                                    <TextBlock Text="Create a fix plan in Cursor" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Expander.Header>
                    <StackPanel Margin="4,6,0,2">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRecord}">
                                    <Button HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                            Style="{StaticResource Button.Subtle}" Padding="8,4" Margin="0,1"
                                            Command="{Binding DataContext.ShowRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayActor}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Value}" Style="{StaticResource Text.Muted}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                       Visibility="{Binding Value, Converter={StaticResource StrToVis}}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Summary + actions -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
          <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <ToggleButton Style="{StaticResource FilterTab}" Padding="18,10" Command="{Binding SelectTabCommand}" CommandParameter="Applied"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Applied, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Applied Rules" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource TabCount}">
                                <TextBlock Text="{Binding AppliedCount}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource FilterTab}" Padding="18,10" Command="{Binding SelectTabCommand}" CommandParameter="WarningsErrors"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=WarningsErrors, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Warnings / Errors" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource TabCount}">
                                <TextBlock Text="{Binding WarningErrorCount}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"
                                           Foreground="{DynamicResource Brush.LevelError}" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton Style="{StaticResource FilterTab}" Padding="18,10" Command="{Binding SelectTabCommand}" CommandParameter="Skipped"
                                  IsChecked="{Binding SelectedTab, Converter={StaticResource Equals}, ConverterParameter=Skipped, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Skipped" FontSize="15" VerticalAlignment="Center" />
                            <Border Style="{StaticResource TabCount}">
                                <TextBlock Text="{Binding SkippedCount}" FontWeight="SemiBold" FontSize="12" TextAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                        </StackPanel>
                    </ToggleButton>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyMarkdownCommand}" ToolTip="Copy Markdown report to clipboard">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Copy report" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyVisibleCommand}" ToolTip="Copy visible rows as text">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Copy rows" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Subtle}" Command="{Binding RevealInExplorerCommand}"
                            ToolTip="Show the downloaded Sundance.log in Windows Explorer">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC50;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                            <TextBlock Text="Show log in Explorer" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: assignment scope boxes (Applied tab) + read workflow -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cAll" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cHlod" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cInc" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cDL" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cGrid" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton Grid.Column="0" Style="{StaticResource ScopeBox}" Margin="0,0,8,0"
                                      Tag="{StaticResource Brush.Type.All}"
                                      Visibility="{Binding IsAppliedTab, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding SelectScopeCommand}" CommandParameter="All"
                                      IsChecked="{Binding SelectedScope, Converter={StaticResource Equals}, ConverterParameter=All, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="All types" VerticalAlignment="Center" />
                                <Border Style="{StaticResource ScopeCount}" Background="{StaticResource Brush.Type.All}">
                                    <TextBlock Text="{Binding AppliedCount}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="1" Style="{StaticResource ScopeBox}" Margin="0,0,8,0"
                                      Tag="{StaticResource Brush.Type.Hlod}"
                                      Visibility="{Binding IsAppliedTab, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding SelectScopeCommand}" CommandParameter="HLODLayer"
                                      IsChecked="{Binding SelectedScope, Converter={StaticResource Equals}, ConverterParameter=HLODLayer, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="HLODLayer" VerticalAlignment="Center" />
                                <Border Style="{StaticResource ScopeCount}" Background="{StaticResource Brush.Type.Hlod}">
                                    <TextBlock Text="{Binding HlodLayerCount}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="2" Style="{StaticResource ScopeBox}" Margin="0,0,8,0"
                                      Tag="{StaticResource Brush.Type.Include}"
                                      Visibility="{Binding IsAppliedTab, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding SelectScopeCommand}" CommandParameter="IncludeInHLOD"
                                      IsChecked="{Binding SelectedScope, Converter={StaticResource Equals}, ConverterParameter=IncludeInHLOD, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="IncludeInHLOD" VerticalAlignment="Center" />
                                <Border Style="{StaticResource ScopeCount}" Background="{StaticResource Brush.Type.Include}">
                                    <TextBlock Text="{Binding IncludeInHlodCount}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="3" Style="{StaticResource ScopeBox}" Margin="0,0,8,0"
                                      Tag="{StaticResource Brush.Type.DataLayer}"
                                      Visibility="{Binding IsAppliedTab, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding SelectScopeCommand}" CommandParameter="DataLayer"
                                      IsChecked="{Binding SelectedScope, Converter={StaticResource Equals}, ConverterParameter=DataLayer, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="DataLayer" VerticalAlignment="Center" />
                                <Border Style="{StaticResource ScopeCount}" Background="{StaticResource Brush.Type.DataLayer}">
                                    <TextBlock Text="{Binding DataLayerCount}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton Grid.Column="4" Style="{StaticResource ScopeBox}" Margin="0,0,8,0"
                                      Tag="{StaticResource Brush.Type.Grid}"
                                      Visibility="{Binding IsAppliedTab, Converter={StaticResource BoolToVis}}"
                                      Command="{Binding SelectScopeCommand}" CommandParameter="RuntimeGrid"
                                      IsChecked="{Binding SelectedScope, Converter={StaticResource Equals}, ConverterParameter=RuntimeGrid, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RuntimeGrid" VerticalAlignment="Center" />
                                <Border Style="{StaticResource ScopeCount}" Background="{StaticResource Brush.Type.Grid}">
                                    <TextBlock Text="{Binding RuntimeGridCount}" FontWeight="SemiBold" FontSize="11" TextAlignment="Center"
                                               Foreground="White" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>

                        <!-- Auto-resolve reading, placed right after the RuntimeGrid scope box -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Border Width="1" Height="34" Background="{DynamicResource Brush.Border}" Margin="4,0,14,0"
                                    VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Action}" Command="{Binding AutoResolveReadingCommand}"
                                    Padding="24,14" FontSize="16" VerticalAlignment="Center"
                                    ToolTip="Use AI to confront every unread applied assignment with your approved/suspicious reports and mark the resolved ones as read">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEC61;" Style="{StaticResource Glyph}" FontSize="20" Margin="0,0,10,0"
                                               Foreground="{DynamicResource Brush.AccentForeground}" />
                                    <TextBlock Text="Auto-resolve reading" Foreground="{DynamicResource Brush.AccentForeground}"
                                               FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Read workflow -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,14,0" Style="{StaticResource Text.Muted}">
                                <Run Text="Read:" /><Run Text="{Binding ReadCount, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="   Showing:" /><Run Text="{Binding ShowingCount, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <ToggleButton Style="{StaticResource FilterTab}" IsChecked="{Binding UnlimitedPage}"
                                          ToolTip="Show every filtered row on a single page (disables paging)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Single page" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource FilterTab}" IsChecked="{Binding ShowRead}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Show read" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Style="{StaticResource Button.Subtle}" Command="{Binding MarkPageReadCommand}"
                                    ToolTip="Mark all currently visible rows as read (hide them)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Mark page read" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Subtle}" Command="{Binding ClearReadCommand}"
                                    ToolTip="Clear all read flags">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7A7;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                    <TextBlock Text="Clear read" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: value filters, each aligned under its scope box (Applied tab only) -->
                    <Grid Grid.Row="1" Margin="0,10,0,0"
                          Visibility="{Binding IsAppliedTab, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cAll" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cHlod" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cInc" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cDL" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="cGrid" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ContentControl Grid.Column="1" Margin="0,0,8,0" Tag="{StaticResource Brush.Type.Hlod}"
                                        HorizontalContentAlignment="Stretch"
                                        Content="{Binding HlodLayerFilter}" ContentTemplate="{StaticResource FilterDropdownTemplate}"
                                        Visibility="{Binding HlodLayerFilter.HasValues, Converter={StaticResource BoolToVis}}" />
                        <ContentControl Grid.Column="2" Margin="0,0,8,0" Tag="{StaticResource Brush.Type.Include}"
                                        HorizontalContentAlignment="Stretch"
                                        Content="{Binding IncludeInHlodFilter}" ContentTemplate="{StaticResource FilterDropdownTemplate}"
                                        Visibility="{Binding IncludeInHlodFilter.HasValues, Converter={StaticResource BoolToVis}}" />
                        <ContentControl Grid.Column="3" Margin="0,0,8,0" Tag="{StaticResource Brush.Type.DataLayer}"
                                        HorizontalContentAlignment="Stretch"
                                        Content="{Binding DataLayerFilter}" ContentTemplate="{StaticResource FilterDropdownTemplate}"
                                        Visibility="{Binding DataLayerFilter.HasValues, Converter={StaticResource BoolToVis}}" />
                        <ContentControl Grid.Column="4" Margin="0,0,8,0" Tag="{StaticResource Brush.Type.Grid}"
                                        HorizontalContentAlignment="Stretch"
                                        Content="{Binding RuntimeGridFilter}" ContentTemplate="{StaticResource FilterDropdownTemplate}"
                                        Visibility="{Binding RuntimeGridFilter.HasValues, Converter={StaticResource BoolToVis}}" />

                        <Button Grid.Column="5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                Style="{StaticResource Button.Subtle}" Command="{Binding ClearFiltersCommand}"
                                ToolTip="Reset the scope and all value filters">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0"
                                           Foreground="{DynamicResource Brush.TextMuted}" />
                                <TextBlock Text="Clear Filters" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
          </StackPanel>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="780" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.ControlBorder}"
                        BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="14"
                                   Foreground="{DynamicResource Brush.TextMuted}" Margin="10,0,0,0" />
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Cursor="Hand"
                                Background="Transparent" BorderThickness="0" Padding="6,0" Margin="0,0,4,0"
                                ToolTip="Clear search"
                                Visibility="{Binding SearchText, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextMuted}" />
                        </Button>
                    </Grid>
                </Border>

                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Include:" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox Content="{Binding FilterAnomalyCount}" ContentStringFormat="Anomalies ({0})" IsChecked="{Binding ShowAnomalies}" Style="{StaticResource FilterCheck}" />
                    <CheckBox Content="{Binding FilterExpectedCount}" ContentStringFormat="Expected ({0})" IsChecked="{Binding ShowExpected}" Style="{StaticResource FilterCheck}" />
                    <CheckBox Content="{Binding FilterKnownNoiseCount}" ContentStringFormat="Known noise ({0})" IsChecked="{Binding ShowKnownNoise}" Style="{StaticResource FilterCheck}" />
                </WrapPanel>

            </Grid>
        </Border>

        <!-- Grid + side panel -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition x:Name="SmartColumn" Width="560" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="RecordsGrid" Grid.Row="0" ItemsSource="{Binding PagedRecords}" AlternationCount="2"
                          SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          SelectionChanged="RecordsGrid_OnSelectionChanged"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding ShowingCount, Converter={StaticResource CountToVis}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Status" Width="140" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRecord}">
                                    <Grid HorizontalAlignment="Left">
                                        <Border CornerRadius="10" Background="{Binding Status, Converter={StaticResource StatusToBrush}}"
                                                Opacity="0.16" />
                                        <StackPanel Orientation="Horizontal" Margin="9,3">
                                            <Border Width="7" Height="7" CornerRadius="4" VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                            <TextBlock Text="{Binding Status}" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Sev" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRecord}">
                                    <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" FontSize="12"
                                               Foreground="{Binding Severity, Converter={StaticResource SevToBrush}}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Type" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRecord}">
                                    <Border CornerRadius="6" HorizontalAlignment="Left" Padding="9,3"
                                            Background="{Binding Category, Converter={StaticResource CatToBrush}}">
                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="White" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="150" />
                        <DataGridTextColumn Header="Actor" Binding="{Binding DisplayActor}" Width="0.55*" MinWidth="200" />

                        <DataGridTemplateColumn x:Name="AiCheckColumn" Header="AI check" Width="150"
                                                CanUserSort="False" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRecord}">
                                    <Button Cursor="Hand" Padding="8,4" BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Accent}" Background="Transparent"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Visibility="{Binding HasAiReviewNote, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.ShowAiThoughtCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding AiReviewNote}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEC61;" Style="{StaticResource Glyph}" FontSize="12"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,6,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="AI review" FontSize="11.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Accent}" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Human check" Width="350" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type core:RuleRecord}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ReadToggleButton}"
                                                Command="{Binding DataContext.ToggleReadCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Toggle this row's reviewed status" />
                                        <Button Style="{StaticResource ApproveToggleButton}" Margin="6,0,0,0"
                                                Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding ApprovalComment}" />
                                        <Button Style="{StaticResource FlagToggleButton}" Margin="6,0,0,0"
                                                Command="{Binding DataContext.ReportSuspiciousCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding SuspiciousComment}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Reason" Binding="{Binding StatusReason}" Width="0.3*" MinWidth="200" />
                    </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state: shown in place of the grid when the filters leave no row -->
                    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding ShowingCount, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                        <TextBlock Text="&#xE9CE;" Style="{StaticResource Glyph}" FontSize="42"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="No data to display" Style="{StaticResource Text.Heading}"
                                   HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="No row matches the current tab and filters."
                                   Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Pagination bar -->
                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}"
                            Padding="10,7" Background="{DynamicResource Brush.SurfaceAlt}">
                        <Grid>
                            <TextBlock Text="{Binding ShowingCount, StringFormat='{}{0} item(s)'}"
                                       Style="{StaticResource Text.Muted}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="&#x2190; Previous" Command="{Binding PreviousPageCommand}"
                                        Padding="12,5" />
                                <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" Margin="14,0"
                                           FontWeight="SemiBold" MinWidth="90" TextAlignment="Center" />
                                <Button Content="Next &#x2192;" Command="{Binding NextPageCommand}"
                                        Padding="12,5" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter (left) + always-visible handle (right) share one band so the splitter
                 resizes the two real panels, not the handle. -->
            <GridSplitter x:Name="SmartSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <Button x:Name="SmartHandle" Grid.Column="1" Style="{StaticResource Button.Subtle}"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                    Width="18" Padding="0"
                    Command="{Binding DataContext.ToggleSmartAnalysisCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    ToolTip="Show / hide the Smart Analysis panel">
                <TextBlock Text="{Binding DataContext.SmartAnalysisToggleGlyph, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" />
            </Button>

            <!-- Side panel: Smart Analysis (our improvements on top of the original web view) -->
            <Border x:Name="SmartPanel" Grid.Column="2" Style="{StaticResource Card}" Padding="0"
                    SizeChanged="SmartPanel_OnSizeChanged">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="14,12,14,4">
                        <TextBlock Text="&#xE9D2;" Style="{StaticResource Glyph}" FontSize="15"
                                   Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                        <TextBlock Text="Smart Analysis" Style="{StaticResource Text.Heading}" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <TabControl Grid.Row="1" Margin="10,4,10,10" Padding="0,8,0,0" BorderThickness="0"
                                Background="Transparent">
                        <!-- Tab 1: Anomalies -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEA39;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0"
                                               Foreground="{DynamicResource Brush.StatusAnomaly}" />
                                    <TextBlock Text="Anomalies" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource TabCount}" Background="{DynamicResource Brush.StatusAnomaly}">
                                        <TextBlock Text="{Binding AnomalyCount}" FontWeight="SemiBold" FontSize="11"
                                                   TextAlignment="Center" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="4"
                                           Text="No anomalies: every applied assignment matches the oracle rules."
                                           Visibility="{Binding AnomalyCount, Converter={StaticResource CountToVis}, ConverterParameter=invert}" />
                                <ListBox ItemsSource="{Binding AnomalyGroups}" ItemTemplate="{StaticResource InsightGroupRow}"
                                         Background="Transparent" BorderThickness="0" Padding="0"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         VirtualizingStackPanel.IsVirtualizing="True"
                                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         Visibility="{Binding AnomalyCount, Converter={StaticResource CountToVis}}">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: AI Report -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="AI Report" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Primary}"
                                            Command="{Binding RunAiCommand}" IsEnabled="{Binding CanUseAi}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE945;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource Brush.AccentForeground}" />
                                            <TextBlock Text="Generate AI report" Foreground="{DynamicResource Brush.AccentForeground}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsAiBusy, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                        <TextBlock Text="Generating AI report..." FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </StackPanel>

                                    <!-- Copy buttons to the right of Generate AI report -->
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasAiReport, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyAiMarkdownCommand}"
                                                ToolTip="Copy the raw Markdown source">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Copy as Markdown" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyAiTextCommand}"
                                                ToolTip="Copy as plain text (Markdown formatting removed)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Copy as Text" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource Text.Muted}"
                                           Text="AI is disabled or the Cursor CLI (cursor-agent) was not found. See Settings &gt; AI for the install steps, then restart the app."
                                           Visibility="{Binding CanUseAi, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.LevelError}"
                                           Text="{Binding AiError}"
                                           Visibility="{Binding AiError, Converter={StaticResource StrToVis}}" />

                                <Grid Grid.Row="2" Margin="0,8,0,0"
                                      Visibility="{Binding HasAiReport, Converter={StaticResource BoolToVis}}">
                                    <!-- Rendered Markdown preview (paper-style, readable in both themes) -->
                                    <Border Background="#FFFFFF" TextElement.Foreground="#1B1D28"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                                        <mdxam:MarkdownScrollViewer Margin="12,8" Markdown="{Binding AiReportText}"
                                                                    Foreground="#1B1D28" Background="Transparent"
                                                                    FontFamily="Segoe UI" FontSize="13"
                                                                    VerticalScrollBarVisibility="Auto"
                                                                    MarkdownStyleName="Compact" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: Assignments (AI) -->
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                    <TextBlock Text="Assignments" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Button.Primary}"
                                            Command="{Binding RunAssignmentAnalysisCommand}" IsEnabled="{Binding CanUseAi}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8AB;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0"
                                                       Foreground="{DynamicResource Brush.AccentForeground}" />
                                            <TextBlock Text="Analyze assignments" Foreground="{DynamicResource Brush.AccentForeground}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding IsAssignmentBusy, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="15" Margin="0,0,8,0"
                                                   Foreground="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                            <TextBlock.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </TextBlock.Triggers>
                                        </TextBlock>
                                        <TextBlock Text="Analyzing assignments..." FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </StackPanel>

                                    <!-- Copy buttons to the right of Analyze assignments -->
                                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasAssignmentReport, Converter={StaticResource BoolToVis}}">
                                        <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyAssignmentMarkdownCommand}"
                                                ToolTip="Copy the raw Markdown source">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Copy as Markdown" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Button.Subtle}" Command="{Binding CopyAssignmentTextCommand}"
                                                ToolTip="Copy as plain text (Markdown formatting removed)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                                <TextBlock Text="Copy as Text" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Style="{StaticResource Text.Muted}"
                                           Text="AI is disabled or the Cursor CLI (cursor-agent) was not found. See Settings &gt; AI for the install steps, then restart the app."
                                           Visibility="{Binding CanUseAi, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.LevelError}"
                                           Text="{Binding AssignmentError}"
                                           Visibility="{Binding AssignmentError, Converter={StaticResource StrToVis}}" />

                                <Grid Grid.Row="2" Margin="0,8,0,0"
                                      Visibility="{Binding HasAssignmentReport, Converter={StaticResource BoolToVis}}">
                                    <Border Background="#FFFFFF" TextElement.Foreground="#1B1D28"
                                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8">
                                        <mdxam:MarkdownScrollViewer Margin="12,8" Markdown="{Binding AssignmentReportText}"
                                                                    Foreground="#1B1D28" Background="Transparent"
                                                                    FontFamily="Segoe UI" FontSize="13"
                                                                    VerticalScrollBarVisibility="Auto"
                                                                    MarkdownStyleName="Compact" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
