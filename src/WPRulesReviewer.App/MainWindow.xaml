<Window x:Class="WPRulesReviewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WPRulesReviewer.App.Views"
        xmlns:vm="clr-namespace:WPRulesReviewer.App.ViewModels"
        Title="World Partition Rules Processing Reviewer" Height="1160" Width="1720" MinHeight="640" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource Brush.Window}"
        TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- Custom title-bar buttons: transparent, light glyphs, subtle hover. Marked hit-test
             visible in chrome so clicks are received instead of starting a window drag. -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarActionButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="FontSize" Value="17" />
        </Style>

        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C50F1F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
            <RowDefinition x:Name="LogRow" Height="360" MinHeight="46" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Custom title bar (always dark, colorful) ===== -->
        <Border Grid.Row="0" x:Name="TitleBar" Height="52"
                BorderBrush="#7A5AF8" BorderThickness="0,0,0,2">
            <Border.Background>
                <!-- Dark base with a colored glow bleeding in from both edges -->
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0"    Color="#3A2A7A" />
                    <GradientStop Offset="0.22" Color="#0C0C16" />
                    <GradientStop Offset="0.5"  Color="#070709" />
                    <GradientStop Offset="0.78" Color="#0C0C16" />
                    <GradientStop Offset="1"    Color="#123A7A" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- Glossy sheen overlay across the top half -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0"   Color="#22FFFFFF" />
                            <GradientStop Offset="0.5" Color="#05FFFFFF" />
                            <GradientStop Offset="1"   Color="#00000000" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: brand mark (vector, so it stays crisp at any DPI) -->
                    <Image Grid.Column="0" Source="{StaticResource Brand.Mark}"
                           Width="26" Height="26" Margin="16,0,0,0" VerticalAlignment="Center" />

                    <!-- Centered application title (transparent to hit-testing so the bar stays draggable) -->
                    <TextBlock Grid.ColumnSpan="3" Text="WORLD PARTITION RULES PROCESSING REVIEWER"
                               FontSize="21" FontWeight="ExtraBold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               FontFamily="Segoe UI Variable Display, Segoe UI">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0"   Color="#66E0FF" />
                                <GradientStop Offset="0.5" Color="#B49CFF" />
                                <GradientStop Offset="1"   Color="#66E0FF" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#7A5AF8" BlurRadius="14" ShadowDepth="0" Opacity="0.55" />
                        </TextBlock.Effect>
                    </TextBlock>

                    <!-- Right: app actions + window caption buttons.
                         Each glyph is an explicit white TextBlock so it never inherits the theme foreground. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBarActionButton}"
                                ToolTip="Toggle light/dark theme" Command="{Binding ToggleThemeCommand}">
                            <TextBlock Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#FFFFFF" />
                        </Button>
                        <Button Style="{StaticResource TitleBarActionButton}" ToolTip="Settings"
                                Command="{Binding ShowSettingsCommand}">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#FFFFFF" />
                        </Button>
                        <Border Width="1" Margin="8,13" Background="#40FFFFFF" />
                        <Button Style="{StaticResource TitleBarButton}" ToolTip="Minimize" Click="TitleBar_Minimize">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFFFFF" />
                        </Button>
                        <Button x:Name="MaxRestoreButton" Style="{StaticResource TitleBarButton}"
                                ToolTip="Maximize" Click="TitleBar_MaximizeRestore">
                            <TextBlock x:Name="MaxRestoreGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="12" Foreground="#FFFFFF" />
                        </Button>
                        <Button Style="{StaticResource TitleBarCloseButton}" ToolTip="Close" Click="TitleBar_Close">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FFFFFF" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== Main content ===== -->
        <Grid Grid.Row="1" Margin="12,12,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="BuildsColumn" Width="400" MinWidth="260" />
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar: TeamCity builds -->
            <Border x:Name="BuildsPanel" Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="16,14,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F5;" Style="{StaticResource Glyph}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                                <TextBlock Text="TeamCity builds" Style="{StaticResource Text.Heading}" />
                            </StackPanel>
                            <TextBlock Text="Check the sessions you want to review." Style="{StaticResource Text.Muted}" Margin="0,3,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Icon}" Content="&#xE72C;"
                                VerticalAlignment="Top" ToolTip="Refresh TeamCity builds"
                                Command="{Binding RefreshBuildsCommand}" />
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,8">
                        <Button Style="{StaticResource Button.Subtle}" Command="{Binding SelectAllBuildsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE762;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Select all" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Subtle}" Command="{Binding ClearBuildSelectionCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E6;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Clear" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Subtle}" Command="{Binding OpenLocalLogCommand}"
                                ToolTip="Open any Sundance.log file from disk">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,6,0" />
                                <TextBlock Text="Open a local Sundance.log..." />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding Builds}" Margin="6,0,6,4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BuildItemViewModel}">
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.StatusExpected}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.StatusAnomaly}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding SessionName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Text.Muted}" Margin="15,1,0,0">
                                            <Run Text="{Binding Number, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding When, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13"
                                               Foreground="{DynamicResource Brush.StatusExpected}" Margin="6,0,4,0"
                                               ToolTip="Already analyzed"
                                               Visibility="{Binding IsAnalyzed, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- More / less -->
                    <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="10,6">
                        <StackPanel>
                            <Button HorizontalAlignment="Stretch" Style="{StaticResource Button.Subtle}"
                                    Command="{Binding ShowMoreBuildsCommand}"
                                    Visibility="{Binding HasMoreBuilds, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE712;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                                    <TextBlock Text="{Binding MoreBuildsLabel}" />
                                </StackPanel>
                            </Button>
                            <Button HorizontalAlignment="Stretch" Style="{StaticResource Button.Subtle}"
                                    Command="{Binding ShowLessBuildsCommand}"
                                    Visibility="{Binding CanCollapseBuilds, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE70E;" Style="{StaticResource Glyph}" Margin="0,0,7,0" />
                                    <TextBlock Text="Show less" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Analyze selected -->
                    <Border Grid.Row="4" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="12,10">
                        <Button HorizontalAlignment="Stretch" Style="{StaticResource Button.Action}"
                                Command="{Binding AnalyzeSelectedCommand}" Click="AnalyzeSelected_OnClick">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE9F5;" Style="{StaticResource Glyph}" Foreground="White" Margin="0,0,8,0" />
                                <TextBlock Text="Analyze selected" FontWeight="SemiBold" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- Handle (left, next to the panel) + splitter (right, next to content) share one band
                 so the splitter resizes the two real panels, not the handle. -->
            <Button x:Name="BuildsHandle" Grid.Column="1" Style="{StaticResource Button.Subtle}"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                    Width="18" Padding="0" Click="ToggleBuildsButton_OnClick"
                    ToolTip="Show / hide the TeamCity builds panel">
                <TextBlock x:Name="BuildsHandleGlyph" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource Brush.TextMuted}" />
            </Button>

            <GridSplitter x:Name="BuildsSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" />

            <!-- Review area / Settings -->
            <Grid Grid.Column="2">
                <!-- Review -->
                <Grid Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}"
                            Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVis}, ConverterParameter=invert}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Glyph}" FontSize="48"
                                       Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" />
                            <TextBlock Text="No session analyzed yet" Style="{StaticResource Text.Heading}"
                                       HorizontalAlignment="Center" Margin="0,14,0,4" />
                            <TextBlock Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextAlignment="Center"
                                       Text="Refresh TeamCity builds and pick sessions, or open a local Sundance.log." />
                        </StackPanel>
                    </Border>

                    <TabControl ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                                Visibility="{Binding Sessions.Count, Converter={StaticResource CountToVis}}">
                        <TabControl.ItemContainerStyle>
                            <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                <Setter Property="IsEnabled" Value="{Binding IsReady}" />
                            </Style>
                        </TabControl.ItemContainerStyle>
                        <TabControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7C3;" Style="{StaticResource Glyph}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                                        <TextBlock x:Name="Spinner" Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12"
                                                   Foreground="{DynamicResource Brush.Accent}" RenderTransformOrigin="0.5,0.5"
                                                   Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="TeamCity processing date"
                                            Visibility="{Binding HasProcessingDate, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.Accent}" Margin="0,0,5,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ProcessingDateLabel}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="processing..." Style="{StaticResource Text.Muted}" FontSize="11"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                            Style="{StaticResource Button.Icon}" Padding="4" Margin="8,0,0,0"
                                            Command="{Binding DataContext.CloseSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsProcessing}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="SpinStoryboard">
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                                     Storyboard.TargetProperty="Angle"
                                                                     From="0" To="360" Duration="0:0:1"
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                                <views:SessionView Margin="0,10,0,0" />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>

                <!-- Settings -->
                <views:SettingsView DataContext="{Binding SettingsVm}"
                                    Visibility="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />

                <!-- Full-view analysis overlay -->
                <Border Panel.ZIndex="20" Background="{DynamicResource Brush.Window}"
                        Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="64"
                                   Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="0" />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsAnalyzing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="OverlaySpinSb">
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                         From="0" To="360" Duration="0:0:1"
                                                                         RepeatBehavior="Forever" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="OverlaySpinSb" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Preparing your review..." Style="{StaticResource Text.Heading}"
                                   FontSize="20" HorizontalAlignment="Center" Margin="0,22,0,6" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Muted}"
                                   HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="520" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Activity log band: splitter (top) + always-visible handle (bottom) =====
             Both share one row so the splitter resizes the two real panels, not the handle. -->
        <GridSplitter x:Name="LogSplitter" Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

        <Button x:Name="LogHandle" Grid.Row="2" Style="{StaticResource Button.Subtle}"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Bottom"
                Height="18" Padding="0" Margin="12,0,12,2" Command="{Binding ToggleActivityLogCommand}"
                ToolTip="Show / hide the bottom panel">
            <TextBlock Text="{Binding BottomPanelToggleGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="12"
                       Foreground="{DynamicResource Brush.TextMuted}" />
        </Button>

        <Border x:Name="BottomPanel" Grid.Row="3" Style="{StaticResource Card}" Margin="12,0,12,8" Padding="0">
            <TabControl x:Name="BottomTabs" Background="Transparent" BorderThickness="0"
                        SelectionChanged="BottomTabs_OnSelectionChanged">
                <TabControl.Resources>
                    <Style TargetType="TabPanel">
                        <Setter Property="Margin" Value="12,8,12,0" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0" />
                            <TextBlock Text="Activity log" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:ActivityLogPanel DataContext="{Binding ActivityLog}" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0" />
                            <TextBlock Text="Selection details" VerticalAlignment="Center" />
                        </StackPanel>
                    </TabItem.Header>
                    <views:RecordInspectorPanel DataContext="{Binding Inspector}" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FB;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0"
                                       Foreground="{DynamicResource Brush.StatusExpected}" />
                            <TextBlock Text="Approved reports" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="6,0" Margin="7,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ApprovedReports.Count}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <views:ReportsPanel DataContext="{Binding ApprovedReports}" />
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB90;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,7,0"
                                       Foreground="#F5A623" />
                            <TextBlock Text="Suspicious reports" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="8" Padding="6,0" Margin="7,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SuspiciousReports.Count}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <views:ReportsPanel DataContext="{Binding SuspiciousReports}" />
                </TabItem>
            </TabControl>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="4" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <ProgressBar Width="120" IsIndeterminate="True" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Copyright}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
